{
  "name": "nexo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NEXO: corredor post-apocalíptico para celular que pasa de 2D a 3D.",
  "scripts": {
    "dev": "vite",
    "dev:celular": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:navegador": "playwright test",
    "verificar": "npm test && npm run test:navegador"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/syncopate": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.187.0",
    "happy-dom": "^21.0.4",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
